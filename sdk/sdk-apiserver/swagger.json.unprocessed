    "/apis/cloud.streamnative.io/v1alpha1/namespaces/{namespace}/pooloptions": {
      "delete": {
        "description": "delete collection of PoolOption",
        "operationId": "deleteCloudStreamnativeIoV1alpha1CollectionNamespacedPoolOption",
        "parameters": [
          {
            "description": "object name and auth scope, such as for teams and projects",
            "in": "path",
            "name": "namespace",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "If 'true', then the output is pretty printed.",
