                "schema": {
                  "$ref": "#/components/schemas/com.github.streamnative.cloud-api-server.pkg.apis.authorization.v1alpha1.IamAccountList"
                }
              },
              "application/vnd.kubernetes.protobuf;stream=watch": {
                "schema": {
                  "$ref": "#/components/schemas/com.github.streamnative.cloud-api-server.pkg.apis.authorization.v1alpha1.IamAccountList"
                }
              }
            },
            "description": "OK"
          }
