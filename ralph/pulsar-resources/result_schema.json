{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pulsar Resources Ralph Loop Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "item_id",
    "lane",
    "summary",
    "files_changed",
    "tests_run",
    "acceptance_notes",
    "commit_subject",
    "next_suggestion"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["implemented", "blocked", "failed", "no_op"]
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "enum": ["protocol", "family", "fix", "docs"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit_subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "next_suggestion": {
      "type": "string"
    }
  }
}
